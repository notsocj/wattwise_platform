# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated artifacts (rendered videos, PDFs, previews)
/output/
/tmp/

# supabase CLI cache
/supabase/.temp/

# survey video audio masters (large binaries kept local)
/wattwise-survey-video/public/**/*.wav
/wattwise-survey-video/public/**/*.mp3

# OpenNext / Wrangler build output
/.open-next/
/.wrangler/
